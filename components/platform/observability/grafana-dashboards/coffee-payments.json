{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" },
    { "name": "DS_LOKI", "label": "Loki", "type": "datasource", "pluginId": "loki", "pluginName": "Loki" },
    { "name": "DS_JAEGER", "label": "Jaeger", "type": "datasource", "pluginId": "jaeger", "pluginName": "Jaeger" }
  ],
  "annotations": { "list": [] },
  "description": "Stripe, inbox, and outbox business telemetry emitted by Payments.Gateway.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (payments_component, payments_operation_name, payments_operation_outcome) (rate(payments_operation_total{payments_component=~\"$component\",payments_operation_outcome=~\"$outcome\"}[$__rate_interval]))", "legendFormat": "{{payments_component}} / {{payments_operation_name}} / {{payments_operation_outcome}}", "range": true, "refId": "A" }
      ],
      "title": "Operation rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, payments_component, payments_operation_name) (rate(payments_operation_duration_seconds_bucket{payments_component=~\"$component\"}[$__rate_interval])))", "legendFormat": "p95 {{payments_component}} / {{payments_operation_name}}", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, payments_component, payments_operation_name) (rate(payments_operation_duration_seconds_bucket{payments_component=~\"$component\"}[$__rate_interval])))", "legendFormat": "p50 {{payments_component}} / {{payments_operation_name}}", "range": true, "refId": "B" }
      ],
      "title": "Operation latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(payments_operation_total{payments_operation_outcome=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(payments_operation_total[$__rate_interval])), 0.000001)", "range": true, "refId": "A" }
      ],
      "title": "Operation error ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 8 },
      "id": 4,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (payments_component, payments_operation_name) (increase(payments_operation_total{payments_operation_outcome=\"error\"}[$__range]))", "legendFormat": "{{payments_component}} / {{payments_operation_name}}", "range": true, "refId": "A" }
      ],
      "title": "Failures in selected range",
      "type": "barchart"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 14 },
      "id": 5,
      "options": { "dedupStrategy": "none", "enableInfiniteScrolling": false, "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [
        { "editorMode": "code", "expr": "{service_name=\"payments-gateway\"} |~ \"(?i)(stripe|inbox|outbox|rabbit|payment|subscription|error|failed)\"", "queryType": "range", "refId": "A" }
      ],
      "title": "Payments logs",
      "type": "logs"
    },
    {
      "datasource": { "type": "jaeger", "uid": "${DS_JAEGER}" },
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 14 },
      "id": 6,
      "options": { "showServiceName": true, "spanBar": { "type": "Tag", "tag": "payments.operation.name" } },
      "targets": [
        { "datasource": { "type": "jaeger", "uid": "${DS_JAEGER}" }, "limit": 100, "operation": "", "query": "", "queryType": "search", "refId": "A", "service": "payments-gateway", "tags": "" }
      ],
      "title": "Payments traces",
      "type": "traces"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["coffee-journal", "payments", "opentelemetry"],
  "templating": {
    "list": [
      { "current": { "text": "All", "value": "$__all" }, "hide": 0, "includeAll": true, "label": "Component", "multi": true, "name": "component", "options": [], "query": "provider,inbox,outbox", "type": "custom" },
      { "current": { "text": "All", "value": "$__all" }, "hide": 0, "includeAll": true, "label": "Outcome", "multi": true, "name": "outcome", "options": [], "query": "success,error,cancelled", "type": "custom" }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Coffee Payments",
  "uid": "coffee-payments",
  "version": 1,
  "weekStart": ""
}
