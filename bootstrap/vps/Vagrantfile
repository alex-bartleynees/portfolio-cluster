# -*- mode: ruby -*-
# vi: set ft=ruby :

VAGRANTFILE_API_VERSION = "2"

Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|
  # Official Rocky box; the generic/* and bento/* Rocky 10 boxes have no libvirt build.
  config.vm.box = "rockylinux/10"

  config.vm.define "k8s" do |k8s|
    k8s.vm.hostname = "k8s"
    k8s.vm.network "private_network", ip: "192.168.56.10"

    k8s.vm.network "forwarded_port", guest: 80, host: 8080
    k8s.vm.network "forwarded_port", guest: 443, host: 8443

    # Provisioning runs from the host over SSH, so the /vagrant share is unused.
    # Disabling it avoids the NFS/virtiofs setup vagrant-libvirt would otherwise need.
    k8s.vm.synced_folder ".", "/vagrant", disabled: true

    k8s.vm.provider "libvirt" do |libvirt|
      libvirt.memory = 8192
      libvirt.cpus = 4
      # Grow the primary disk from the box default up to 100 GiB.
      libvirt.machine_virtual_size = 100
      # Guest DNS is handled by the libvirt NAT network's dnsmasq, which forwards
      # to the host's resolvers (systemd-resolved / Tailscale).
    end

    k8s.vm.provision "ansible" do |ansible|
      ansible.playbook = "site.yml"
      ansible.vault_password_file = ".vault_pass"
      ansible.groups = {
        "k8s_master" => ["k8s"],
        "k8s_nodes" => ["k8s"]
      }
      ansible.extra_vars = {
        pod_network_cidr: "10.244.0.0/16"
      }
    end
  end
end
